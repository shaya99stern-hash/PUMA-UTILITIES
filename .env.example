# Database: Supabase Postgres pooler with puma_app role
DATABASE_URL=

# Supabase public configuration
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Authentication and encryption
NEXT_PUBLIC_APP_URL=
PUMA_ENCRYPTION_KEY=
PUMA_CRON_SECRET=

# Optional: require sign-in for all routes (set to '1' to enable)
PUMA_REQUIRE_LOGIN=

# OAuth: Gmail integration (optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# OAuth: Outlook integration (optional)
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

# Web search APIs (optional, choose one or more)
BRAVE_SEARCH_API_KEY=
SERPER_API_KEY=
GOOGLE_CSE_KEY=
GOOGLE_CSE_CX=

# Browser research worker (optional)
PUMA_BROWSER_RESEARCH_URL=
PUMA_BROWSER_RESEARCH_TOKEN=

# Voice transcription (optional, check app/api/transcribe/route.ts for actual variable name if different)
OPENAI_API_KEY=
